                    <cost name=" gc" typeId="points" value="25" />
                  </costs>
                </entryLink>
                <entryLink id="9401-77e2-9a59-5b3a" name="Blunderbuss" hidden="false" collective="false" import="true" targetId="4386-7400-9146-1dee" type="selectionEntry">
                  <constraints>
                    <constraint id="09f5-31a0-61f8-567a" type="max" field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                    <constraint id="fc73-45fc-d47c-5a9a" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                </entryLink>
              </entryLinks>
              <selectionEntries>
                <selectionEntry id="fef5-fd47-402c-597b" name="Hunting Rifle" page="0" hidden="false" collective="false" import="true" type="upgrade">
                  <constraints>
