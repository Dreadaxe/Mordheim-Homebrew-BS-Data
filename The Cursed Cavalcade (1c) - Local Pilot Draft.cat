      <rules>
        <rule id="1f4a-ad12-d57d-572b" name="Expert Swordsman" hidden="false">
          <description>As imperial nobles, the Companions have been taught the way of the sword since an early age. Companions all have Expert Swordsman Skill.</description>
        </rule>
      </rules>
