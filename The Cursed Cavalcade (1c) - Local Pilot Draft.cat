      </profiles>
      <rules>
        <rule id="4226-4c94-4516-5a32" name="Leader" hidden="false">
          <description>Any warrior of the Cavalcade Warband within 6" of the Aristocrat may use his Leadership value when taking Leadership tests.</description>
        </rule>
        <rule id="21f2-3733-8e80-53a7" name="Expert Horseman" hidden="false">
          <description>the Aristocrat has the Ride (Nightmare) skill.</description>
        </rule>
      </rules>
      <categoryLinks>
        <categoryLink id="a895-d65b-9d94-53a7" name="Heroes" hidden="false" targetId="a0fce0bc-02e0-a064-7a39-5b97ff8a9c94" primary="true" />
      </categoryLinks>
