              <selectionEntries>
                <selectionEntry id="443b-e4c1-de33-580e" name="Hunting Rifle" page="0" hidden="false" collective="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="61c5-8a07-fb27-5e59" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <rules>
                    <rule id="66e8-a8b4-faa8-5a7c" name="Source note" hidden="false">
                      <description>No matching Hunting Rifle entry was found in the current shared data catalogue. The 200 GC list price is shown, but the weapon profile/mechanics need a source check.</description>
                    </rule>
                  </rules>
                  <costs>
                    <cost name=" gc" typeId="points" value="200" />
