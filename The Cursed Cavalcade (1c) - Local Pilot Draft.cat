      <rules>
        <rule id="440c-1bd2-1ada-5b5e" name="Charge" hidden="false">
          <description>When charging their enemies the Wild Beasts gain +1 Attack on the first turn of close combat.</description>
        </rule>
        <rule id="3028-f26d-c4d3-59dc" name="Animal" hidden="false">
          <description>Wild Beasts are animals and thus do not gain experience.</description>
        </rule>
        <rule id="323d-8e24-d55b-5938" name="Equipment note" hidden="false">
          <description>Wild Beasts never use weapons and armour, and do not need them to fight effectively.</description>
        </rule>
      </rules>
      <categoryLinks>
