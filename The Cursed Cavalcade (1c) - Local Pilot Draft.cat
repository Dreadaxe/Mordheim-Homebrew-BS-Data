              <selectionEntries>
                <selectionEntry id="ec65-cdaa-bee4-5f08" name="Nightmare" page="0" hidden="false" collective="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="1c07-ece2-bb9f-538b" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
