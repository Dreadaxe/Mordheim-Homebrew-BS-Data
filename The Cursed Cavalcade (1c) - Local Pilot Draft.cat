                    <cost name="Rarity" typeId="rarity" value="0" />
                  </costs>
                </selectionEntry>
                <selectionEntry id="d999-aa24-c39f-5db8" name="Bird Of Prey" page="0" hidden="false" collective="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="076c-c0aa-2a45-52f4" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <rules>
                    <rule id="b0ac-1eff-c4d2-52fd" name="Bird of Prey" hidden="false">
                      <description>The Bird of Prey can be used in the Shooting Phase exactly like a Missile weapon with the following exceptions: it has a range of 18", does not need line of sight (but cannot be used against hidden targets) and ignores penalties for moving, long range and cover. Use the BS of its owner to determine if it hits. If successful, the attack causes a Strength 4 hit.</description>
                    </rule>
                  </rules>
                  <costs>
                    <cost name=" gc" typeId="points" value="30" />
                    <cost name=" Warband Rating" typeId="wb-rating" value="0" />
                    <cost name="Rarity" typeId="rarity" value="0" />
                  </costs>
                </selectionEntry>
              </selectionEntries>
