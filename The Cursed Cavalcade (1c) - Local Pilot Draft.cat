      <constraints>
        <constraint id="049b-6087-2e3e-51f3" type="min" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
        <constraint id="1f6b-7fa5-dbcc-5d78" type="max" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
