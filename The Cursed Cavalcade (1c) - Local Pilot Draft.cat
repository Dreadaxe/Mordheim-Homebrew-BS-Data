              <selectionEntries>
                <selectionEntry id="0d69-645c-663c-5975" name="Banner of the Noble House" page="0" hidden="false" collective="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="8b04-0727-13cf-5893" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <rules>
                    <rule id="0f9c-b993-3ca1-51b3" name="Banner of the Noble House" hidden="false">
                      <description>The bearer gains +1 Leadership, to a maximum of 10. If the bearer is not knocked down, stunned or fleeing, friendly models within 12 inches may reroll failed All Alone tests. The bearer must use one hand to carry the banner and cannot carry a shield, buckler, double-handed weapon or off-hand weapon in combat.</description>
                    </rule>
                  </rules>
                  <costs>
                    <cost name=" gc" typeId="points" value="25" />
                    <cost name=" Warband Rating" typeId="wb-rating" value="0" />
                    <cost name="Rarity" typeId="rarity" value="0" />
                  </costs>
                </selectionEntry>
              </selectionEntries>
            </selectionEntryGroup>
          </selectionEntryGroups>
        </selectionEntry>
