      <rules>
        <rule id="1f7f-24ae-a531-50ec" name="Maddened With Pain" hidden="false">
          <description>As soon as the Great Bear suffers a single wound it gains an additional attack.</description>
        </rule>
        <rule id="8c46-1490-9f51-54e4" name="Large Target" hidden="false">
          <description>Great Bears are Large Targets as defined in the shooting rules.</description>
        </rule>
        <rule id="0f0a-e2ae-e7ae-55c0" name="Animal" hidden="false">
          <description>Great Bears are animals and thus do not gain experience.</description>
        </rule>
        <rule id="7676-33fe-038d-5873" name="Equipment note" hidden="false">
          <description>Great Bears never use weapons and armour, and do not need them to fight effectively.</description>
        </rule>
      </rules>
      <categoryLinks>
        <categoryLink id="4598-9862-d728-55f3" name="Henchmen" hidden="false" targetId="f9b08d8e-4922-78d5-78ad-2047bff52dc8" primary="true" />
