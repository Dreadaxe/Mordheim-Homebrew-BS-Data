              <selectionEntries>
                <selectionEntry id="c771-9c9c-b528-5f43" name="Cathayan Quilted Silk Armour" page="0" hidden="false" collective="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="d537-8785-d428-530b" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <rules>
                    <rule id="8e11-2603-ff4d-5dec" name="Cathayan Quilted Silk Armour" hidden="false">
                      <description>The Silk Armour adds +1 to the armour saves against any type of attack. It can be combined with any other type of armour.</description>
                    </rule>
                  </rules>
                  <costs>
                    <cost name=" gc" typeId="points" value="15" />
                    <cost name=" Warband Rating" typeId="wb-rating" value="0" />
                    <cost name="Rarity" typeId="rarity" value="0" />
                  </costs>
                </selectionEntry>
              </selectionEntries>
