              <entryLinks>
                <entryLink id="791c-093c-ae35-5c22" name="Superior Blackpowder" hidden="false" collective="false" import="true" targetId="332b-3337-b827-2014" type="selectionEntry">
                  <constraints>
                    <constraint id="4e9d-7d33-f794-5c7e" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                </entryLink>
              </entryLinks>
              <selectionEntries>
                <selectionEntry id="3c43-a011-c92a-5bd5" name="Banner of the Noble House" page="0" hidden="false" collective="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="77a2-88f2-2879-54ea" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <rules>
                    <rule id="8641-cedd-5b61-5522" name="Banner of the Noble House" hidden="false">
                      <description>The bearer gains +1 Leadership, to a maximum of 10. If the bearer is not knocked down, stunned or fleeing, friendly models within 12 inches may reroll failed All Alone tests. The bearer must use one hand to carry the banner and cannot carry a shield, buckler, double-handed weapon or off-hand weapon in combat.</description>
                    </rule>
                  </rules>
                  <costs>
                    <cost name=" gc" typeId="points" value="25" />
                    <cost name=" Warband Rating" typeId="wb-rating" value="0" />
                    <cost name="Rarity" typeId="rarity" value="0" />
                  </costs>
                </selectionEntry>
              </selectionEntries>
            </selectionEntryGroup>
          </selectionEntryGroups>
        </selectionEntry>
