            <characteristic name="LD" typeId="e234eaea-a02a-2fb7-3e1f-605392aabb89">5</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="9504-024a-757e-52a5" name="Extra servitors, worthless, but still precious" hidden="false">
          <description>Captured Thralls do not count toward the maximum number of models allowed in your warband, effectively increasing the maximum capacity from 13 to 18. You cannot dismiss any Captured Thrall you own.</description>
        </rule>
        <rule id="116e-3a54-674c-5f38" name="Not really clever" hidden="false">
          <description>Captured Thralls cannot earn experience points, and therefore cannot gain any advancement.</description>
        </rule>
        <rule id="6eae-6a78-4e03-5317" name="Recruitment note" hidden="false">
          <description>Only added after the post-battle Throne of Worms result. New Recruit cannot enforce that acquisition path in this draft; the 0 GC cost is retained so the model can be recorded.</description>
        </rule>
      </rules>
