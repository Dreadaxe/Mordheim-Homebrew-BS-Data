    <selectionEntry id="0a75-cf62-5310-5cbc" name="Fighting Ape" page="0" hidden="false" collective="false" import="true" type="unit">
      <profiles>
        <profile id="9131-2546-04d5-5f1f" name="Fighting Apes" page="0" hidden="false" typeId="e1beaa44-e54d-dd6b-d1f2-446b333c9bb9" typeName="Model">
          <characteristics>
            <characteristic name="M" typeId="2a0bcc4c-8266-418f-13d6-a6b44def5e92">6</characteristic>
            <characteristic name="WS" typeId="d5aca8ba-0204-b324-b976-c2b536e09924">3</characteristic>
            <characteristic name="BS" typeId="5b4d181b-23ae-5ed7-9262-c1d2f79246a8">0</characteristic>
            <characteristic name="S" typeId="7f1f0a4d-68dc-b0df-5703-c4d0d91a93b9">4</characteristic>
            <characteristic name="T" typeId="54f4796b-dedb-c296-8b1a-ff7f8043293a">4</characteristic>
            <characteristic name="W" typeId="3172c8dc-ebe4-0c40-72ab-8fd0076b9442">1</characteristic>
            <characteristic name="I" typeId="a6fd52b0-be0a-655e-6314-87b392c9c90e">5</characteristic>
            <characteristic name="A" typeId="bf393c37-9d10-fc85-c147-62b1c01a89fe">2</characteristic>
            <characteristic name="LD" typeId="e234eaea-a02a-2fb7-3e1f-605392aabb89">5</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="f7a5-5ec9-2886-5f1b" name="Cymbals" hidden="false">
          <description>when hiring a Fighting Ape, you may give her a pair of cymbals at 15 gc, which it frenziedly beats together to the forbidding tune of Danse Macabre. Any enemy model within 6" will be so disturbed by the sound that they suffer a penalty of -1 to BS and Ld.</description>
        </rule>
        <rule id="927b-d42e-32de-5a8a" name="Agile" hidden="false">
          <description>The Fighting Apes are fantastically agile and nimble, putting even the greatest acrobat or Skaven Assassin to shame. The Fighting Ape has the Scale Sheer Surfaces Skill, Acrobat Skill, and Dodge Skill. In addition, the Fighting Ape can make a diving charge from up to 10" high.</description>
        </rule>
        <rule id="ec92-8a4d-d6ca-59d3" name="Animal" hidden="false">
          <description>Fighitng Apes are animals and thus do not gain experience, but can still climb and enter buildings as normal.</description>
        </rule>
        <rule id="7c1e-347c-3c02-5f6e" name="Equipment note" hidden="false">
          <description>A Fighting Ape never uses weapons and armor and does not need them to fight effectively.</description>
        </rule>
      </rules>
      <categoryLinks>
        <categoryLink id="3e7c-1e4c-e939-5dc5" name="Henchmen" hidden="false" targetId="f9b08d8e-4922-78d5-78ad-2047bff52dc8" primary="true" />
      </categoryLinks>
      <selectionEntries>
        <selectionEntry id="1f43-5812-72bd-571b" name="Cymbals" page="0" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5c7c-d128-0c82-5ea9" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <rules>
            <rule id="036b-f851-405d-57ae" name="Cymbals" hidden="false">
              <description>Optional when hiring, 15 GC. Enemy models within 6 inches suffer -1 BS and -1 Leadership.</description>
            </rule>
          </rules>
          <costs>
            <cost name=" gc" typeId="points" value="15" />
            <cost name=" Warband Rating" typeId="wb-rating" value="0" />
            <cost name="Rarity" typeId="rarity" value="0" />
          </costs>
        </selectionEntry>
        <selectionEntry id="2627-d655-3827-5cf2" name="Fighting Ape" page="0" hidden="false" collective="false" import="true" type="model">
          <constraints>
            <constraint id="cfee-3941-e5b8-5905" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
            <constraint id="fd9f-b61d-805e-551e" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
            <constraint id="e365-fcff-d0e8-5dbb" type="max" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <costs>
            <cost name=" gc" typeId="points" value="95" />
            <cost name=" Warband Rating" typeId="wb-rating" value="5" />
            <cost name="Rarity" typeId="rarity" value="0" />
          </costs>
        </selectionEntry>
      </selectionEntries>
