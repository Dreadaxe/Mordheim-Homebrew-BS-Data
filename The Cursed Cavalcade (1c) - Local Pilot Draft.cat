              <selectionEntries>
                <selectionEntry id="5906-12e0-978b-5782" name="Cathayan Quilted Silk Armour" page="0" hidden="false" collective="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="2dfe-7301-0276-5efe" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <rules>
                    <rule id="1777-4812-9164-5e00" name="Cathayan Quilted Silk Armour" hidden="false">
                      <description>The Silk Armour adds +1 to the armour saves against any type of attack. It can be combined with any other type of armour.</description>
                    </rule>
                  </rules>
                  <costs>
                    <cost name=" gc" typeId="points" value="15" />
                    <cost name=" Warband Rating" typeId="wb-rating" value="0" />
                    <cost name="Rarity" typeId="rarity" value="0" />
                  </costs>
